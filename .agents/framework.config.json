{
  "version": "2.0.0",
  "framework": "AI Agent Engineering Framework",
  "stopGate": {
    "frameworkOnlyProfiles": [
      "framework-validator"
    ],
    "frameworkPathPrefixes": [
      ".agents/",
      "docs/"
    ]
  },
  "commandPolicy": {
    "allowedCommands": ["node .agents/scripts/eval-runner.mjs"],
    "allowedBackgroundCommands": [],
    "allowedPatterns": []
  },
  "mcpPolicy": {
    "defaultDecision": "allow",
    "servers": {},
    "agentGrants": {}
  },
  "memory": {
    "enabled": true,
    "file": ".agents/memory/decision-log.md",
    "maxEntries": 30,
    "maxBytes": 4000
  },
  "ruleReminders": [
    {
      "id": "git-workflow",
      "rule": ".agents/rules/git-workflow.md",
      "reason": "It covers commit, merge, rebase, and push practice.",
      "command": {
        "program": "git",
        "subcommands": ["commit", "merge", "rebase", "push", "cherry-pick"]
      }
    },
    {
      "id": "architecture",
      "rule": ".agents/rules/architecture.md",
      "reason": "It covers module boundaries, dependencies, and integrations.",
      "pathGlobs": ["docs/architecture/**", "**/adr/**", "**/architecture-decisions/**"]
    }
  ],
  "fingerprint": {
    "additionalExclusions": []
  },
  "validation": {
    "linkCheckExclusions": [
      "ECC-framework"
    ]
  },
  "claudeCode": {
    "modelMap": {
      "pro": "opus",
      "flash": "sonnet"
    }
  },
  "expectedCounts": {
    "rules": 126,
    "skills": 81,
    "templates": 11,
    "subagents": 9,
    "docs": 10,
    "skillBindings": 61,
    "workflows": 15
